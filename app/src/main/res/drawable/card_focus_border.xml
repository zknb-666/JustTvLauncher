<?xml version="1.0" encoding="utf-8"?>
<!--
  选中态边框：只在卡片获得焦点时显示白框。
  未选中项是纯透明 ColorDrawable，不绘制任何形状，
  避免「未激活的行」出现残留色块/黑框。
  配合 focus_border 的 duplicateParentState 由系统自动切换，零对象分配。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true"
        android:drawable="@drawable/card_focus_border_shape" />
    <item android:drawable="@android:color/transparent" />
</selector>
