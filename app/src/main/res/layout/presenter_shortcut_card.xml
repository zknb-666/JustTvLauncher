<?xml version="1.0" encoding="utf-8"?>
<androidx.leanback.widget.BaseCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!--
      旧配置使用 ellipsize="marquee" + marqueeRepeatLimit="marquee_forever"，
      会让所有可见卡片持续 invalidate 重绘（1920x1080 / 双核 A9 上常驻掉帧）。
      改为静态两行截断；需要完整名称时由聚焦卡片自行处理。
    -->
    <TextView
        android:id="@+id/content"
        android:layout_width="@dimen/card_width"
        android:layout_height="@dimen/card_height"
        android:duplicateParentState="false"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        tools:ignore="RtlHardcoded,RtlSymmetry" />
</androidx.leanback.widget.BaseCardView>
